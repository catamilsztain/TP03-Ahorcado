@{
    ViewData["Title"] = "Home Page";
    }

<h1>AHORCADO</h1>
<h2>Ahorcado game es un juego donde tenes que adivinar la palabra oculta arriesgando de a una letra. Cada palabra tiene mínimo 8 letras. Tenes máximo 10 intentos.</h2>
<div id="mostrar"></div>

<div >
    <h1>Intentos restantes:</h1>
    <h2 id = "intento">10</h2>
</div>

<input id="letra" type="text" name = "letra" maxlength="1">

<input id="ocultis" type="hidden" name = "oculta" value="@ViewBag.Palabra">

<h2 id = "mensaje"></h2>
<button onclick="ArriesgarLetra()"> Arriesgar </button>